{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "covenant_courier.product_receipt.v1",
    "title":  "Covenant Courier Product Receipt v1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema",
                     "receipt_id",
                     "message_id",
                     "event_type",
                     "time_utc",
                     "frame_id",
                     "payload_sha256",
                     "decision"
                 ],
    "properties":  {
                       "schema":  {
                                      "const":  "covenant_courier.product_receipt.v1"
                                  },
                       "receipt_id":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "message_id":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "event_type":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "time_utc":  {
                                        "type":  "string",
                                        "minLength":  1
                                    },
                       "frame_id":  {
                                        "type":  "string",
                                        "minLength":  1
                                    },
                       "payload_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^[a-f0-9]{64}$"
                                          },
                       "decision":  {
                                        "enum":  [
                                                     "sent",
                                                     "accepted",
                                                     "rejected",
                                                     "quarantined",
                                                     "failed"
                                                 ]
                                    },
                       "reason_code":  {
                                           "type":  [
                                                        "string",
                                                        "null"
                                                    ]
                                       }
                   }
}
